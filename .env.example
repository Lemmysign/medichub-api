# MedicHub Academy — environment variables (CLAUDE.md §7)
# Copy to .env and fill in real values. NEVER commit .env with real secrets.

# Database (Railway Postgres)
DB_URL=jdbc:postgresql://localhost:5432/medichub
DB_USER=postgres
DB_PASSWORD=postgres

# Spring profile (leave 'local' for dev; set 'prod' in production)
SPRING_PROFILES_ACTIVE=local

# Admin (preconfigured platform owner) — REQUIRED; no default, must be set explicitly
ADMIN_EMAIL=admin@medichubacademy.com

# Auth rate limit (requests per client IP per minute to /api/auth/**)
AUTH_RATE_LIMIT_PER_MINUTE=20

# Upload size limits
MAX_FILE_SIZE=25MB
MAX_REQUEST_SIZE=30MB

# Frontend origin (CORS)
FRONTEND_URL=http://localhost:5174

# JWT
JWT_SECRET=change-me-to-a-long-random-base64-secret-value
JWT_ACCESS_TTL_MIN=30
JWT_REFRESH_TTL_DAYS=7

# Email OTP — set true in local dev to log codes to the console (never in prod)
OTP_LOG_CODES=false

# Email (Resend / Brevo SMTP)
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=no-reply@medichubacademy.com

# Bunny Stream
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_AUTH_KEY=

# Cloudflare R2 — gated PDFs / course materials
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET=medichub-materials
R2_PUBLIC_BASE_URL=

# Cloudinary — public course thumbnails / images
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_PLAN_CODE=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_CALLBACK_URL=http://localhost:5173/subscription/callback

# Subscription plan (price NOT hardcoded — set the real price here, in kobo)
SUBSCRIPTION_PLAN_NAME=MedicHub Academy Subscription
SUBSCRIPTION_PLAN_PRICE_KOBO=
SUBSCRIPTION_PLAN_CURRENCY=NGN
SUBSCRIPTION_PLAN_INTERVAL_DAYS=30

# Progress tracking (optional; defaults to 30)
PROGRESS_COMPLETE_THRESHOLD_SECONDS=30
